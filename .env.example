# Local Vite + Node API. Copy to .env; never commit .env.
NODE_ENV=development
PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESEND_API_KEY=
RESEND_FROM_EMAIL=advisor@studentspace.com
NOTIFY_EMAIL=advisor@studentspace.com
# Preview only: must be a separate test inbox, never a production recipient.
PREVIEW_NOTIFY_EMAIL=
SITE_URL=https://www.studentspace.com
SITE_INDEXABLE=false
CONTENT_APPROVED=false
# Set true on Vercel only after configuring and testing the edge rate limit.
EDGE_RATE_LIMIT_CONFIGURED=false
